{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "worklog hook --harness codex --event SessionStart",
            "timeout": 15,
            "additionalContextLimit": 60000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "worklog hook --harness codex --event UserPromptSubmit",
            "timeout": 15,
            "additionalContextLimit": 60000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|Edit|MultiEdit|NotebookEdit|PowerShell|Write|apply_patch|exec_command|shell|shell_command|terminal)$",
        "hooks": [
          {
            "type": "command",
            "command": "worklog hook --harness codex --event PreToolUse",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "worklog hook --harness codex --event Stop",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "worklog hook --harness codex --event SessionEnd",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
